# The standalone platform instrumentation calls the Kotlin suspend entry point.
# These test-only entry points are not additional production release keep rules.
-keepclassmembers class com.prosincerity.ghostwriter.dictionary.data.EspeakIpa {
    public <init>(android.content.Context);
    public java.lang.Object ipa(java.lang.String, java.lang.String, kotlin.coroutines.Continuation);
}
-keep class kotlin.coroutines.EmptyCoroutineContext {
    public static final kotlin.coroutines.EmptyCoroutineContext INSTANCE;
}
